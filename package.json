{
  "name": "quant-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Quant System Full-Stack Polyglot Monorepo",
  "scripts": {
    "dev:common": "uv run uvicorn common_server.main:app --host 0.0.0.0 --port 8090 --reload",
    "dev:server": "uv run uvicorn quant_server.main:app --host 0.0.0.0 --port 8080 --reload",
    "dev:data": "cd packages/stock-data && uv run python service/app.py",
    "dev:web": "pnpm --filter web-admin dev",
    "backtest": "uv run python run_backtest.py",
    "test:core": "uv run pytest packages/quant-core/tests -v",
    "test:data": "uv run pytest packages/stock-data/tests -m 'not live' -v"
  },
  "devDependencies": {}
}
