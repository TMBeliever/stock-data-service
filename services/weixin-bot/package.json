{
  "name": "weixin-bot",
  "version": "1.0.0",
  "description": "A lightweight, independent WeChat Bot SDK based on official iLink protocol, with zero OpenClaw dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev:simple": "tsx examples/simple-bot.ts",
    "dev:agent": "tsx examples/agent-bridge.ts"
  },
  "keywords": [
    "wechat",
    "weixin",
    "bot",
    "agent",
    "ilink"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
